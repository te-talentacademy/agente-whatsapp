# =========================================================================
# Variables de entorno del agente — copia estos nombres en Railway.
# La explicación completa de cada una vive en docs/variables.md.
# Aquí solo hay ejemplos: NUNCA escribas tus llaves reales en este archivo.
# =========================================================================

# --- Puesta en marcha (obligatorias las 4) -------------------------------
WHATSAPP_TOKEN=pega-aqui-tu-token-permanente
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_VERIFY_TOKEN=tu-palabra-secreta
META_APP_SECRET=pega-aqui-el-app-secret-de-tu-app

# --- Comportamiento base (opcionales) ------------------------------------
AUTO_REPLY=on
AUTO_REPLY_TEXT=
LOG_MESSAGE_TEXT=on
DB_PATH=

# --- El cerebro (se enciende en su fase del curso) -----------------------
FEATURE_BRAIN=off
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
AGENT_NAME=
DAILY_MESSAGE_LIMIT=

# --- La libreta de conocimiento (se enciende en su fase) -----------------
FEATURE_RAG=off

# --- Oídos, ojos y voz (se encienden en su fase) -------------------------
FEATURE_VOICE_IN=off
FEATURE_VOICE_OUT=off
FEATURE_VISION=off
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
OPENROUTER_VISION_MODEL=
DAILY_VOICE_LIMIT=

# --- El teléfono (se enciende en su fase) --------------------------------
FEATURE_CALLS=off
FEATURE_OUTBOUND_CALLS=off
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
CALL_MAX_MINUTES=
CALL_DAILY_MINUTES_LIMIT=
